@model Agriculture_Analyst.Models.InventoryTransaction

@{
    ViewData["Title"] = "Nhập kho";
}
<link rel="stylesheet" href="~/css/bootstrap.min.css" />
<h2 class="mb-4">📥 Nhập kho</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="card p-4 shadow-sm border-0">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger mb-3 border p-2 border-danger rounded"></div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="fw-bold mb-1">Chọn kho hàng</label>
            <select asp-for="InvId" asp-items="ViewBag.InventoryList" class="form-select">
                <option value="">-- Chọn kho --</option>
            </select>
        </div>

        <div class="col-md-6 mb-3">
            <label class="fw-bold mb-1">Chọn vật tư</label>
            <select asp-for="ItemId" asp-items="ViewBag.ItemList" class="form-select">
                <option value="">-- Chọn vật tư --</option>
            </select>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="fw-bold mb-1">Số lượng</label>
            <input asp-for="SoLuong" class="form-control" type="number" min="1" />
            <span asp-validation-for="SoLuong" class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3">
            <label class="fw-bold mb-1">Đơn giá</label>
            <input asp-for="DonGia" class="form-control" type="number" min="0" />
            <span asp-validation-for="DonGia" class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3">
            <label class="fw-bold mb-1">Lãi suất (%)</label>
            <input asp-for="LaiSuat" class="form-control" type="number" step="0.1" min="0" />
        </div>
    </div>

    <div class="form-group mb-4 mt-2 p-3 bg-light rounded border border-success border-opacity-25">
        <label class="fw-bold mb-2 text-success">📷 Ảnh minh chứng (Sản phẩm/Hóa đơn)</label>
        <input type="file" name="imageFile" class="form-control" accept="image/*" />
        <small class="text-muted fst-italic mt-1 d-block">Tùy chọn: Chụp lại bao bì sản phẩm hoặc hóa đơn mua hàng để tiện quản lý và đối soát sau này.</small>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success fw-bold px-4">
            💾 Xác nhận Nhập Kho
        </button>
        <a asp-action="Index" class="btn btn-secondary px-4">
            ↩ Quay lại
        </a>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}