@model IEnumerable<Agriculture_Analyst.Models.InventoryTransaction>

@{
    ViewData["Title"] = "Lịch sử giao dịch";
}

<style>
    :root {
        --primary-green: #2ecc71;
        --dark-green: #27ae60;
        --card-shadow: 0 4px 12px rgba(0,0,0,0.05);
    }

    body {
        background-color: #f8f9fa;
    }

    /* Container Box */
    .table-container {
        background: white;
        border-radius: 16px;
        box-shadow: var(--card-shadow);
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.05);
    }

    /* Tiêu đề bảng */
    .table-header-custom th {
        background-color: #fdfdfd;
        color: #6c757d;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #edf2f7;
        padding: 1rem;
    }

    /* Row style */
    .table tbody tr {
        transition: background-color 0.2s ease;
    }

        .table tbody tr:hover {
            background-color: #fbfbfc;
        }

    .table td {
        vertical-align: middle;
        padding: 1rem;
        border-bottom: 1px solid #edf2f7;
    }

    /* Icon badge */
    .type-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .badge-import {
        background-color: #e8f8f5;
        color: #1abc9c;
    }

    .badge-export {
        background-color: #fff8e1;
        color: #f39c12;
    }

    /* Nhấn mạnh tên vật tư */
    .item-name {
        font-size: 1.05rem;
        color: #2c3e50;
    }

    .inventory-name {
        font-size: 0.85rem;
        color: #95a5a6;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* Khung vụ mùa */
    .plant-tag {
        display: inline-block;
        margin-top: 6px;
        padding: 3px 10px;
        background-color: #f0fdf4;
        color: #15803d;
        border: 1px dashed #bbf7d0;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
    }
</style>

<div class="card shadow-sm border-0 mb-4 bg-white" style="border-radius: 12px;">
    <div class="card-body p-3 p-md-4">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">

            <div class="col-md-2">
                <label class="form-label text-muted small fw-bold mb-1">Phân loại</label>
                <select name="type" class="form-select border-0 bg-light">
                    <option value="">-- Tất cả --</option>
                    <option value="1" selected="@(ViewBag.Type == 1 ? "selected" : null)">📥 Chỉ Nhập kho</option>
                    <option value="2" selected="@(ViewBag.Type == 2 ? "selected" : null)">📤 Chỉ Xuất dùng</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label text-muted small fw-bold mb-1">Kho hàng</label>
                <select name="invId" asp-items="ViewBag.InventoryList" class="form-select border-0 bg-light">
                    <option value="">-- Tất cả kho --</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label text-muted small fw-bold mb-1">Vật tư</label>
                <select name="itemId" asp-items="ViewBag.ItemList" class="form-select border-0 bg-light">
                    <option value="">-- Tất cả vật tư --</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label text-muted small fw-bold mb-1">Từ ngày</label>
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control border-0 bg-light" />
            </div>

            <div class="col-md-2">
                <label class="form-label text-muted small fw-bold mb-1">Đến ngày</label>
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control border-0 bg-light" />
            </div>

            <div class="col-12 mt-3 d-flex justify-content-end gap-2 border-top pt-3">
                <a asp-action="Index" class="btn btn-light text-muted fw-bold">
                    🔄 Đặt lại
                </a>
                <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm" style="background-color: var(--primary-green); border: none;">
                    🔍 Lọc dữ liệu
                </button>
            </div>
        </form>
    </div>
</div>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--text-dark);">📜 Lịch sử Giao dịch Kho</h2>
            <p class="text-muted mb-0">Theo dõi toàn bộ luồng nhập xuất vật tư nông nghiệp.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                ➕ Nhập kho
            </a>
            <a asp-action="Export" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm text-dark">
                📤 Xuất dùng
            </a>
        </div>
    </div>

    <div class="table-container">
        <div class="table-responsive">
            <table class="table table-borderless align-middle mb-0">
                <thead class="table-header-custom">
                    <tr>
                        <th class="ps-4">Loại giao dịch</th>
                        <th>Chi tiết Vật tư & Kho</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Thành tiền</th>
                        <th class="text-center pe-4">Thời gian</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        bool isImport = item.Type == 1;

                        string badgeClass = isImport ? "badge-import" : "badge-export";
                        string badgeIcon = isImport ? "📥" : "📤";
                        string badgeText = isImport ? "Nhập kho" : "Xuất dùng";

                        string moneyColor = isImport ? "text-success" : "text-danger";
                        string sign = isImport ? "+" : "-";

                        <tr>
                            <td class="ps-4">
                                <span class="type-badge @badgeClass">
                                    <span>@badgeIcon</span> @badgeText
                                </span>
                            </td>

                            <td>
                                <div class="d-flex align-items-center gap-3">

                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <a href="@item.ImageUrl" target="_blank" title="Bấm để xem ảnh gốc" class="flex-shrink-0">
                                            <img src="@item.ImageUrl" alt="Sản phẩm"
                                                 style="width: 52px; height: 52px; object-fit: cover; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 2px 5px rgba(0,0,0,0.08); transition: 0.2s;"
                                                 onmouseover="this.style.transform='scale(1.05)'"
                                                 onmouseout="this.style.transform='scale(1)'" />
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="flex-shrink-0 d-flex justify-content-center align-items-center"
                                             style="width: 52px; height: 52px; background: #f8f9fa; border-radius: 8px; border: 1px dashed #cbd5e1; color: #94a3b8; font-size: 1.2rem;">
                                            📦
                                        </div>
                                    }

                                    <div>
                                        <div class="fw-bold item-name">
                                            @item.Item.ItemName <span class="fw-normal text-muted fs-6">(@item.Item.Unit)</span>
                                        </div>
                                        <div class="inventory-name mt-1">
                                            🏭 Lưu tại: @item.Inventory.InvName
                                        </div>

                                        @if (!isImport && item.Plant != null)
                                        {
                                            <div class="plant-tag">
                                                🌱 Dùng cho: @item.Plant.PlantName
                                            </div>
                                        }
                                    </div>

                                </div>
                            </td>

                            <td class="text-center">
                                <span class="fs-5 fw-bold" style="color: #34495e;">@item.SoLuong</span>
                            </td>

                            <td class="text-end text-muted">
                                @item.DonGia.ToString("N0") <small>đ</small>
                            </td>

                            <td class="text-end fw-bold @moneyColor fs-5">
                                @sign @item.ThanhTien.ToString("N0") <small>đ</small>
                            </td>

                            <td class="text-center text-secondary pe-4">
                                <div class="fw-bold" style="color: #7f8c8d;">
                                    @(item.NgayGiaoDich.HasValue? item.NgayGiaoDich.Value.ToString("dd/MM/yyyy") : "-")
                                </div>
                                <div class="small text-muted">
                                    @(item.NgayGiaoDich.HasValue? item.NgayGiaoDich.Value.ToString("HH:mm") : "")
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div class="fs-1 text-muted mb-3">📦</div>
                <h5 class="text-muted fw-bold">Chưa có giao dịch nào</h5>
                <p class="text-secondary">Hãy bắt đầu bằng cách nhập vật tư vào kho.</p>
            </div>
        }
    </div>
</div>