@model Plant
<link rel="stylesheet" href="~/css/bootstrap.min.css" />

<div class="container mt-4" style="max-width: 600px;">
    <h3 class="mb-4 fw-bold text-success">✏️ Cập nhật thông tin Vụ mùa</h3>

    <form asp-action="Edit" method="post" class="card p-4 shadow-sm border-0">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="PlantId" />

        <div class="form-group mb-3">
            <label class="fw-bold mb-1">Tên cây</label>
            <input asp-for="PlantName" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label class="fw-bold mb-1">Loại cây</label>
            <input asp-for="PlantType" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label class="fw-bold mb-1">Ngày bắt đầu</label>
            <input asp-for="StartDate" type="date" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label class="fw-bold mb-1">Diện tích (m²)</label>
            <input asp-for="Area" class="form-control" type="number" step="0.1" />
        </div>

        <div class="form-group mb-4">
            <label class="fw-bold mb-1 text-primary">Trạng thái</label>
            <select asp-for="Status" class="form-select border-primary">
                <option value="Đang trồng">🌱 Đang trồng</option>
                <option value="Chờ thu hoạch">⏳ Chờ thu hoạch</option>
                <option value="Đã thu hoạch">✅ Đã thu hoạch (Hoàn thành)</option>
                <option value="Tạm ngưng">⏸️ Tạm ngưng</option>
                <option value="Hủy bỏ">❌ Hủy bỏ</option>
            </select>
            <small class="text-muted fst-italic">Lưu ý: Chọn "Đã thu hoạch" để có thể đăng báo cáo lên diễn đàn.</small>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success fw-bold px-4">💾 Lưu thay đổi</button>
            <a asp-action="Index" class="btn btn-secondary px-4">Hủy</a>
        </div>
    </form>
</div>