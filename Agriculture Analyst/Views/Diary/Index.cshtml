          }
        ]
      }
    };

    function renderList(id, items) {
        const el = document.getElementById(id);
        el.innerHTML = "";
        items.forEach(i => {
            const li = document.createElement("li");
            li.textContent = i;
            el.appendChild(li);
        });
    }

    function loadGuide() {
        document.getElementById("guideTitle").textContent = data.title;
        document.getElementById("checklistTitle").textContent = data.checklistTitle;
        document.getElementById("tasksTitle").textContent = data.tasksTitle;

        renderList("checklist", data.checklist);
        renderList("tasks", data.tasks);
    }

    function loadVietGap() {
        const container = document.getElementById("vietgapContent");
        container.innerHTML = "";

        document.getElementById("vietgapTitle").textContent = data.vietgap.title;

        data.vietgap.sections.forEach(s => {
            const h = document.createElement("h6");
            h.textContent = s.name;

            const ul = document.createElement("ul");

            s.items.forEach(i => {
                const li = document.createElement("li");
                li.textContent = i;
                ul.appendChild(li);
            });

            container.appendChild(h);
            container.appendChild(ul);
        });
    }

    document.getElementById("startGuideModal")
        .addEventListener("show.bs.modal", loadGuide);

    document.getElementById("vietgapModal")
        .addEventListener("show.bs.modal", loadVietGap);
</script>