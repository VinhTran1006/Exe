@{
    ViewData["Title"] = "Đăng nhập & Đăng ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Agriculture Analyst</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />

    <style>
        :root {
            --primary-color: #27ae60;
            --primary-light: #2ecc71;
            --text-dark: #2c3e50;
            --text-muted: #7f8c8d;
            --bg-color: #f0fdf4; /* Xanh lá siêu nhạt */
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: var(--bg-color);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        /* --- CONTAINER CHÍNH --- */
        .auth-container {
            background-color: #fff;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            position: relative;
            overflow: hidden;
            width: 900px;
            max-width: 100%;
            min-height: 550px;
        }

        .form-container {
            position: absolute;
            top: 0;
            height: 100%;
            transition: all 0.6s ease-in-out;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        /* Form Đăng nhập */
        .sign-in-container {
            left: 0;
            width: 50%;
            z-index: 2;
        }

        /* Form Đăng ký */
        .sign-up-container {
            left: 0;
            width: 50%;
            opacity: 0;
            z-index: 1;
        }

        /* --- HIỆU ỨNG TRƯỢT (ACTIVE) --- */
        .auth-container.right-panel-active .sign-in-container {
            transform: translateX(100%);
            opacity: 0;
        }

        .auth-container.right-panel-active .sign-up-container {
            transform: translateX(100%);
            opacity: 1;
            z-index: 5;
            animation: show 0.6s;
        }

        @@keyframes show {
            0%, 49.99% {
                opacity: 0;
                z-index: 1;
            }

            50%, 100% {
                opacity: 1;
                z-index: 5;
            }
        }

        /* --- OVERLAY (Mảng xanh che phủ) --- */
        .overlay-container {
            position: absolute;
            top: 0;
            left: 50%;
            width: 50%;
            height: 100%;
            overflow: hidden;
            transition: transform 0.6s ease-in-out;
            z-index: 100;
        }

        .auth-container.right-panel-active .overlay-container {
            transform: translateX(-100%);
        }

        .overlay {
            background: linear-gradient(135deg, var(--primary-light), var(--primary-color));
            background-size: cover;
            background-position: 0 0;
            color: #ffffff;
            position: relative;
            left: -100%;
            height: 100%;
            width: 200%;
            transform: translateX(0);
            transition: transform 0.6s ease-in-out;
        }

        .auth-container.right-panel-active .overlay {
            transform: translateX(50%);
        }

        .overlay-panel {
            position: absolute;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            padding: 0 40px;
            text-align: center;
            top: 0;
            height: 100%;
            width: 50%;
            transform: translateX(0);
            transition: transform 0.6s ease-in-out;
        }

        .overlay-left {
            transform: translateX(-20%);
        }

        .auth-container.right-panel-active .overlay-left {
            transform: translateX(0);
        }

        .overlay-right {
            right: 0;
            transform: translateX(0);
        }

        .auth-container.right-panel-active .overlay-right {
            transform: translateX(20%);
        }

        /* --- STYLING NỘI DUNG --- */
        h1 {
            font-weight: 800;
            margin-bottom: 20px;
            color: var(--text-dark);
            text-align: center;
        }

        .overlay h1 {
            color: #fff;
        }

        .overlay p {
            font-size: 1.1rem;
            font-weight: 300;
            line-height: 1.6;
            letter-spacing: 0.5px;
            margin: 20px 0 30px;
        }

        form {
            display: flex;
            flex-direction: column;
            width: 100%;
        }

        .form-group {
            margin-bottom: 15px;
            width: 100%;
        }

        .form-row {
            display: flex;
            gap: 15px;
        }

            .form-row .form-group {
                margin-bottom: 15px;
                width: 50%;
            }

        input, select {
            background-color: #f4f6f9;
            border: 1px solid #e2e8f0;
            padding: 12px 15px;
            border-radius: 8px;
            width: 100%;
            outline: none;
            transition: all 0.3s;
            font-size: 0.95rem;
        }

            input:focus, select:focus {
                border-color: var(--primary-light);
                background-color: #fff;
                box-shadow: 0 0 0 3px rgba(46, 204, 113, 0.1);
            }

        button {
            border-radius: 8px;
            border: none;
            background: var(--primary-color);
            color: #ffffff;
            font-size: 1rem;
            font-weight: bold;
            padding: 12px 45px;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: transform 0.1s ease-in, box-shadow 0.3s;
            cursor: pointer;
            margin-top: 10px;
            width: 100%;
        }

            button:hover {
                box-shadow: 0 8px 15px rgba(39, 174, 96, 0.3);
                background: #219a52;
            }

            button:active {
                transform: scale(0.98);
            }

            button.ghost {
                background-color: transparent;
                border: 2px solid #ffffff;
                box-shadow: none;
                width: auto;
            }

                button.ghost:hover {
                    background: #fff;
                    color: var(--primary-color);
                }

        .error-message {
            color: #e74c3c;
            font-size: 0.8rem;
            margin-top: 5px;
            display: block;
        }

        .form-note {
            font-size: 0.85rem;
            color: var(--text-muted);
            text-align: center;
            margin-top: 15px;
        }

        .divider {
            text-align: center;
            margin: 15px 0;
            color: #cbd5e1;
            font-weight: bold;
            font-size: 0.9rem;
        }

        .btn-home-link {
            position: absolute;
            top: 20px;
            left: 20px;
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 5px;
            transition: 0.2s;
        }

            .btn-home-link:hover {
                color: var(--primary-color);
            }

        .mobile-toggle {
            display: none;
            text-align: center;
            margin-top: 20px;
            font-weight: 600;
            color: var(--text-dark);
        }

            .mobile-toggle a {
                color: var(--primary-color);
                text-decoration: none;
            }

        /* --- RESPONSIVE CHO ĐIỆN THOẠI --- */
        @@media (max-width: 768px) {
            .auth-container {
                min-height: 650px;
                width: 100%;
                border-radius: 12px;
            }

            .form-container {
                width: 100%;
                padding: 30px 20px;
            }
            /* Ẩn tấm mảng che (overlay) trên Mobile vì nó chiếm chỗ */
            .overlay-container {
                display: none;
            }
            /* Logic chuyển đổi ẩn hiện cho Mobile */
            .sign-in-container {
                opacity: 1;
                transform: translateX(0);
                z-index: 5;
            }

            .sign-up-container {
                opacity: 0;
                transform: translateX(0);
                z-index: 1;
                pointer-events: none;
            }

            .auth-container.right-panel-active .sign-in-container {
                opacity: 0;
                z-index: 1;
                pointer-events: none;
            }

            .auth-container.right-panel-active .sign-up-container {
                opacity: 1;
                z-index: 5;
                pointer-events: auto;
            }

            .mobile-toggle {
                display: block;
            }
            /* Hiện nút chuyển đổi trên mobile */
        }
    </style>
</head>
<body>
    <div class="auth-container" id="container">

        <div class="form-container sign-up-container">
            <a href="/" class="btn-home-link d-md-none">← Trang chủ</a>
            <form method="post" asp-action="SignUp" asp-controller="Home" id="signupForm">
                @Html.AntiForgeryToken()

                <h1 class="mt-3">Tạo tài khoản</h1>

                @if (ViewData["signupError"] != null)
                {
                    <div class="alert alert-danger py-2 mb-3 shadow-sm rounded-3">@ViewData["signupError"]</div>
                }

                <div class="form-row">
                    <div class="form-group">
                        <input type="text" name="Username" placeholder="Tên đăng nhập" required>
                        @Html.ValidationMessage("Username", new { @class = "error-message" })
                    </div>
                    <div class="form-group">
                        <input type="text" name="Name" placeholder="Họ và tên" required>
                        @Html.ValidationMessage("Name", new { @class = "error-message" })
                    </div>
                </div>

                <div class="form-group">
                    <input type="email" name="Email" placeholder="Email liên hệ" required>
                    @Html.ValidationMessage("Email", new { @class = "error-message" })
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <input type="tel" name="Phone" placeholder="Số điện thoại">
                    </div>
                    <div class="form-group">
                        <select name="Gender">
                            <option value="">Giới tính</option>
                            <option value="Male">Nam</option>
                            <option value="Female">Nữ</option>
                            <option value="Other">Khác</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <input type="password" name="Password" placeholder="Mật khẩu (Ít nhất 6 ký tự)" required>
                    @Html.ValidationMessage("Password", new { @class = "error-message" })
                </div>
                <div class="form-group">
                    <input type="password" name="ConfirmPassword" placeholder="Xác nhận mật khẩu" required>
                    @Html.ValidationMessage("ConfirmPassword", new { @class = "error-message" })
                </div>

                <button type="submit" id="btnSignUp">Đăng ký ngay</button>
                <p class="form-note mb-0">Bằng cách đăng ký, bạn đồng ý với Điều khoản của chúng tôi</p>

                <p class="mobile-toggle">Đã có tài khoản? <a href="#" id="mobileSignInLink">Đăng nhập</a></p>
            </form>
        </div>

        <div class="form-container sign-in-container">
            <a href="/" class="btn-home-link">← Trang chủ</a>
            <form method="post" asp-action="SignIn" asp-controller="Home" id="signinForm">
                @Html.AntiForgeryToken()

                <h1>Đăng nhập</h1>
                <p class="text-center text-muted mb-4 d-none d-md-block">Chào mừng bạn quay lại với hệ thống quản lý</p>

                @if (ViewData["signinError"] != null)
                {
                    <div class="alert alert-danger py-2 mb-3 shadow-sm rounded-3">@ViewData["signinError"]</div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success py-2 mb-3 shadow-sm rounded-3">@TempData["SuccessMessage"]</div>
                }

                <div class="form-group">
                    <input type="text" name="Username" placeholder="Tên đăng nhập" required>
                    @Html.ValidationMessage("Username", new { @class = "error-message" })
                </div>

                <div class="form-group mb-2">
                    <input type="password" name="Password" placeholder="Mật khẩu" required>
                    @Html.ValidationMessage("Password", new { @class = "error-message" })
                </div>

                <div class="d-flex justify-content-end w-100 mb-3">
                    <a href="/Home/ForgotPassword" style="color: var(--primary-color); font-size: 0.9rem; font-weight: 600; text-decoration: none;">Quên mật khẩu?</a>
                </div>

                <button type="submit" id="btnSignIn">Đăng nhập</button>

                <p class="mobile-toggle">Chưa có tài khoản? <a href="#" id="mobileSignUpLink">Tạo tài khoản</a></p>
            </form>
        </div>

        <div class="overlay-container d-none d-md-block">
            <div class="overlay">
                <div class="overlay-panel overlay-left">
                    <h1>Mừng bạn trở lại!</h1>
                    <p>Để tiếp tục quản lý nông trại, vui lòng đăng nhập bằng tài khoản cá nhân của bạn.</p>
                    <button type="button" class="ghost" id="signIn">Đăng nhập</button>
                </div>
                <div class="overlay-panel overlay-right">
                    <h1>Chào bạn mới!</h1>
                    <p>Tham gia cùng chúng tôi để tối ưu hóa quản lý vật tư và cây trồng cho nông trại của bạn.</p>
                    <button type="button" class="ghost" id="signUp">Tạo tài khoản</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const container = document.getElementById('container');

        // Nút trên PC
        const btnOverlaySignUp = document.getElementById('signUp');
        const btnOverlaySignIn = document.getElementById('signIn');

        // Nút trên Mobile
        const btnMobileSignUp = document.getElementById('mobileSignUpLink');
        const btnMobileSignIn = document.getElementById('mobileSignInLink');

        // Hàm kích hoạt Form Đăng ký
        function showSignUp(e) {
            if(e) e.preventDefault();
            container.classList.add("right-panel-active");
        }

        // Hàm kích hoạt Form Đăng nhập
        function showSignIn(e) {
            if(e) e.preventDefault();
            container.classList.remove("right-panel-active");
        }

        // Gán sự kiện cho PC
        if(btnOverlaySignUp) btnOverlaySignUp.addEventListener('click', showSignUp);
        if(btnOverlaySignIn) btnOverlaySignIn.addEventListener('click', showSignIn);

        // Gán sự kiện cho Mobile
        if(btnMobileSignUp) btnMobileSignUp.addEventListener('click', showSignUp);
        if(btnMobileSignIn) btnMobileSignIn.addEventListener('click', showSignIn);

        // Hiển thị Form phù hợp nếu có lỗi hoặc thông báo thành công từ Server
        @if (ViewData["showSignIn"] != null || TempData["SuccessMessage"] != null || ViewData["signinError"] != null)
        {
                <text>
                document.addEventListener('DOMContentLoaded', () => { showSignIn(); });
                </text>
        }
        else if (ViewData["signupError"] != null)
        {
                <text>
                document.addEventListener('DOMContentLoaded', () => { showSignUp(); });
                </text>
        }
    </script>
</body>
</html>