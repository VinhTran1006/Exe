@model List<Agriculture_Analyst.Models.Post>
@{
    ViewData["Title"] = "Cộng đồng Nông nghiệp";
}

<link rel="stylesheet" href="~/css/bootstrap.min.css" />
<style>
    body { background-color: #f0f2f5; font-family: 'Segoe UI', sans-serif; }
    .container-custom { display: flex; max-width: 1000px; margin: 20px auto; gap: 20px; }

    .feed { flex-grow: 1; max-width: 680px; margin: 0 auto; width: 100%; }

    /* Box Tạo bài viết */
    .create-post { background: white; border-radius: 12px; padding: 15px; margin-bottom: 20px; box-shadow: 0 1px 2px rgba(0,0,0,0.1); }
    .create-post textarea { background: #f0f2f5; border: none; border-radius: 12px; padding: 15px; width: 100%; outline: none; resize: none; margin-bottom: 10px; }

    /* Box Tuỳ chọn đăng */
    .post-options { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; padding-top: 10px; border-top: 1px solid #e4e6eb; }
    .option-btn { display: flex; align-items: center; gap: 5px; cursor: pointer; padding: 8px 12px; border-radius: 8px; transition: 0.2s; font-weight: 600; color: #65676b; }
    .option-btn:hover { background-color: #f2f2f2; }

    /* Thẻ Bài viết */
    .post { background: white; border-radius: 12px; padding: 15px 15px 5px; margin-bottom: 20px; box-shadow: 0 1px 2px rgba(0,0,0,0.1); }
    .post-header { display: flex; align-items: center; margin-bottom: 15px; }
    .post-avatar { width: 40px; height: 40px; border-radius: 50%; background: #2ecc71; color: white; display: flex; align-items: center; justify-content: center; font-weight: bold; margin-right: 10px; font-size: 1.2rem; }
    .post-name { font-weight: bold; color: #050505; }
    .post-time { font-size: 0.8rem; color: #65676b; }

    .post-content { margin-bottom: 15px; color: #050505; white-space: pre-wrap; }
    .post-image { width: 100%; max-height: 500px; object-fit: cover; border-radius: 8px; margin-bottom: 15px; }

    /* Box Trích xuất dữ liệu (Đính kèm) */
    .report-attachment { background: #f8f9fa; border: 1px solid #e9ecef; border-left: 4px solid #f39c12; border-radius: 8px; padding: 15px; margin-bottom: 15px; }

    .post-actions { display: flex; border-top: 1px solid #ced0d4; padding-top: 5px; }
    .action-btn { flex: 1; text-align: center; padding: 8px; color: #65676b; font-weight: 600; cursor: pointer; border-radius: 5px; transition: 0.2s; }
    .action-btn:hover { background-color: #f2f2f2; }
</style>

<div class="container-custom">
    <div class="feed">

        <div class="create-post">
            <form asp-action="CreatePost" asp-controller="Home" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="d-flex align-items-start gap-2">
                    <div class="post-avatar bg-primary">U</div>
                    <textarea name="content" rows="3" placeholder="Chia sẻ kinh nghiệm hoặc trạng thái nông trại của bạn..." required></textarea>
                </div>

                <div class="post-options">
                    <label class="option-btn text-success mb-0">
                        <input type="file" name="imageFile" accept="image/*" style="display: none;" id="imgUpload" onchange="previewText()">
                        📷 Thêm Ảnh
                    </label>
                    <span id="imgName" class="small text-muted"></span>

                    <div class="d-flex align-items-center gap-2 ms-auto">
                        <select name="plantId" class="form-select form-select-sm" style="max-width: 200px; border-radius: 20px;">
                            <option value="">-- Không đính kèm báo cáo --</option>
                            @if (ViewBag.HarvestedPlants != null)
                            {
                                foreach (var p in ViewBag.HarvestedPlants)
                                {
                                    <option value="@p.PlantId">Công bố: @p.PlantName</option>
                                }
                            }
                        </select>
                        <button type="submit" class="btn btn-primary btn-sm fw-bold px-4 rounded-pill">Đăng</button>
                    </div>
                </div>
            </form>
        </div>

        @if (Model != null && Model.Any())
        {
            foreach (var post in Model)
            {
                <div class="post">
                    <div class="post-header">
                        <div class="post-avatar">@(post.User?.Username?.Substring(0, 1).ToUpper() ?? "U")</div>
                        <div>
                            <div class="post-name">@(post.User?.Username ?? "Người dùng ẩn danh")</div>
                            <div class="post-time">@post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    </div>

                    <div class="post-content">@post.Content</div>

                    @if (!string.IsNullOrEmpty(post.ImageUrl))
                    {
                        <img src="@post.ImageUrl" class="post-image" alt="Ảnh bài viết" />
                    }

                    @if (post.Plant != null)
                    {
                        <div class="report-attachment">
                            <h6 class="fw-bold text-warning mb-2">📊 Báo cáo vụ mùa được công bố</h6>
                            <p class="mb-1"><strong>Cây trồng:</strong> @post.Plant.PlantName (@post.Plant.PlantType)</p>
                            <p class="mb-2"><strong>Diện tích:</strong> @post.Plant.Area m² | <strong>Trạng thái:</strong> @post.Plant.Status</p>

                            <a asp-controller="Plant" asp-action="Report" asp-route-id="@post.Plant.PlantId" class="btn btn-sm btn-outline-warning text-dark fw-bold mt-2">
                                📑 Xem chi tiết trích xuất dữ liệu
                            </a>
                        </div>
                    }

                    @* <div class="post-actions">
                        <div class="action-btn">👍 Thích</div>
                        <div class="action-btn">💬 Bình luận</div>
                        <div class="action-btn">↗ Chia sẻ</div>
                    </div> *@
                </div>
            }
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <h5>Chưa có bài viết nào!</h5>
                <p>Hãy là người đầu tiên chia sẻ trên diễn đàn.</p>
            </div>
        }
    </div>
</div>

<script>
    // JS nhỏ để hiện tên ảnh khi chọn xong
    function previewText() {
        var input = document.getElementById('imgUpload');
        if(input.files && input.files[0]) {
            document.getElementById('imgName').innerText = input.files[0].name;
        }
    }
</script>